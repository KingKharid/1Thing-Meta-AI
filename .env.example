# 1Thing — environment template
#
# Copy to .env for local work. Never commit the real file.
# On Render/Vercel, set these in the dashboard instead.

# ---------------------------------------------------------------- database
# Local dev falls back to sqlite:///./onething.db when this is unset.
# Production must be PostgreSQL; the app has no migration story for SQLite.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/onething

# ------------------------------------------------------------------- model
# Meta Model API (Muse Spark 1.3, Muse Wonder for voice/vision).
MODEL_API_KEY=
META_TEAM_ID=
META_API_BASE_URL=https://api.meta.ai/v1
# Media goes through /v1/responses; these are the routable model ids.
META_VOICE_MODEL=muse-wonder-1.0
META_VISION_MODEL=muse-wonder-1.0
MODEL_TIMEOUT_SECONDS=20
MEDIA_TIMEOUT_SECONDS=90

# Baseten open weights — the primary engine, and the open-weights bonus.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
# "baseten" keeps open weights first; "meta" makes the hosted model lead.
PRIMARY_ENGINE=baseten

# -------------------------------------------------------------------- media
# Modal worker that normalizes WhatsApp voice notes (ogg) to 16kHz wav.
MODAL_WORKER_URL=

# ------------------------------------------------------------------ whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ------------------------------------------------------------------- server
PORT=8000
# Comma-separated. Wildcard is allowed but disables credentialed CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_API_KEY=
SECRET_KEY=

# Invariants 4 and 5 (midnight sweep, stall nudge) run only when this is 1.
RUN_SCHEDULER=1

# The identity /demo/reset is allowed to touch. Never a real user.
DEMO_PHONE=+15550007777

# Captures per minute per identity. 0 disables the limiter (tests use 0).
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------- web
# These live in web/.env.local (Vercel: Project -> Settings -> Environment).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PHONE_NUMBER=+15550007777
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Server-side only; never prefix this with NEXT_PUBLIC_.
ADMIN_API_KEY=
