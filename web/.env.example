# Copy to .env.local and adjust for your machine.
#
# NEXT_PUBLIC_API_URL: reachable FastAPI base URL. Leave empty to render
#   the offline preview instead of live data.
# NEXT_PUBLIC_PHONE_NUMBER: testing identity shared across web, mobile,
#   watch, and WhatsApp. Sent as the X-Phone-Number header.
# NEXT_PUBLIC_WHATSAPP_NUMBER: digits only, no "+". Drives the wa.me link
#   on the standby surface. Leave empty to hide the call to action rather
#   than render a dead link.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PHONE_NUMBER=+15550007777
NEXT_PUBLIC_WHATSAPP_NUMBER=15550007777
