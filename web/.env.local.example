# 1Thing web — local environment
#
# Copy to .env.local. This file is gitignored; never commit real keys.

# The public backend. On Vercel this is the Render URL.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# The identity the browser acts as. The demo account by default.
NEXT_PUBLIC_PHONE_NUMBER=+15550007777

# The WhatsApp business number shown on the surface, if any.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Server-side only: sent as X-Admin-Key by the /admin page.
# Must match the backend's ADMIN_API_KEY. Never prefix with NEXT_PUBLIC_.
ADMIN_API_KEY=
