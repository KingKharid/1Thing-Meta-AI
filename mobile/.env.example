# Copy to .env (gitignored) and adjust for your machine.
#
# EXPO_PUBLIC_API_URL: reachable FastAPI base URL. Expo Go on a physical
# device cannot use localhost — use your dev machine's LAN IP instead,
# e.g. http://192.168.1.20:8000 (same Wi-Fi, port 8000 open).
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Testing identity shared across web, mobile, and watch surfaces.
EXPO_PUBLIC_PHONE_NUMBER=+15550007777
